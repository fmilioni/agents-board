# Postgres (Docker)
POSTGRES_USER=organizer
POSTGRES_PASSWORD=organizer
POSTGRES_DB=organizer
POSTGRES_PORT=5544

# DATABASE_URL used by db, api and mcp packages
DATABASE_URL=postgres://organizer:organizer@localhost:5544/organizer

# API
API_PORT=4400
API_HOST=127.0.0.1

# Web (Nuxt)
# Access the web on the SAME host as the API below (use 127.0.0.1, not
# localhost): the session cookie is host-bound + SameSite=Lax, so a mismatched
# host makes it cross-site and the cookie won't be sent. Behind the reverse proxy
# (remote), AUTH_COOKIE_DOMAIN shares the cookie across the app./api. subdomains.
NUXT_PUBLIC_API_URL=http://127.0.0.1:4400

# MCP transport (Streamable HTTP only — stdio was dropped in H5)
# The MCP always serves Streamable HTTP at /mcp. MCP_HTTP_PORT overrides the
# port (default 4402).
# MCP_HTTP_PORT=4402
# Public base URL clients reach the MCP at — the OAuth token audience / the
# `resource` in the protected-resource metadata. Defaults to :4402.
# MCP_PUBLIC_URL=http://127.0.0.1:4402
# When auth is enabled, /mcp requires a valid OAuth bearer (no static token);
# when disabled, it stays open. The MCP needs BETTER_AUTH_SECRET/URL to validate.

# Embedding service (semantic search)
# The embedding model runs in its own service (packages/embedding-service); api
# and mcp are thin HTTP clients. EMBEDDING_SERVICE_URL points them at it — set it
# for local dev and run `pnpm dev:embedding`. WITHOUT it (or with the service
# down), search degrades gracefully to lexical-only.
EMBEDDING_SERVICE_URL=http://127.0.0.1:4403
# Port the embedding service listens on (default 4403).
# EMBEDDING_SERVICE_PORT=4403
# EMBEDDING_MODEL / EMBEDDING_DTYPE are FALLBACKS: the choice persisted in the
# setup/config UI (system_settings) takes precedence over these envs, which in
# turn beat the code default. Factory default: Xenova/multilingual-e5-small + q8.
# Model selection (registry id Xenova/multilingual-e5-{small|base|large}, or
# `none` to disable embeddings entirely — the client then never calls the service).
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Quantization of the loaded weights — one of fp32 / fp16 / q8 (q8 ≈ 120MB vs
# fp32 ≈ 470MB). Switching dtype is lazy: the dim is unchanged, so existing
# vectors stay valid and nothing is re-embedded.
# EMBEDDING_DTYPE=q8
# Stable weights cache dir for the service (a mounted volume in Docker). Unset in
# local dev keeps the Transformers.js default cache location.
# EMBEDDING_CACHE_DIR=/cache/transformers

# Auth (better-auth)
# BETTER_AUTH_SECRET: required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public base URL of the API (where better-auth is mounted).
BETTER_AUTH_URL=http://127.0.0.1:4400
# Origins allowed to call the auth endpoints (CSRF check), comma-separated.
# The web runs cross-origin from the API, so its origin must be listed.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:4401
# Parent domain that scopes the session cookie so it's shared across the app./api.
# subdomains behind the reverse proxy. Leave UNSET locally (web/API share a host).
# See docker-compose.prod.yml / .env.prod.example for the remote setup.
# AUTH_COOKIE_DOMAIN=example.com
# Lifetime of the OAuth tokens the MCP login issues, IN SECONDS. The access
# token is what an MCP client carries; when it expires the client is expected to
# renew with its refresh token, and a client that doesn't makes you log in
# again — hence the generous default. Defaults: 604800 (7 days) and 2592000
# (30 days). A value that is non-numeric, non-positive or above 31536000
# (1 year) is ignored (logged) and the default applies. Shorten both if the
# board is exposed to the internet.
# MCP_ACCESS_TOKEN_TTL=604800
# MCP_REFRESH_TOKEN_TTL=2592000

# Commit token (diff capture with auth on)
# Signs the short-lived, card-scoped token the MCP mints (issue_commit_token) so
# attach-commit / attach-worktree-diff can write a card's diff without a browser
# session. api and mcp MUST share the same value. OPTIONAL — when empty it falls
# back to BETTER_AUTH_SECRET (already per-instance). Set it to separate the keys.
# AB_COMMIT_TOKEN_SECRET=

# GitHub OAuth (OPTIONAL). Leave both empty to run with e-mail+password only —
# the web hides the "Sign in with GitHub" button. To enable it, register an
# OAuth App (https://github.com/settings/developers) with callback URL
# http://127.0.0.1:4400/api/auth/callback/github and fill these in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
