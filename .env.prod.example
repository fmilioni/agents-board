# Production env for the reverse-proxy overlay (docker-compose.prod.yml).
# Copy to .env and fill in, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Public subdomains routed by Caddy — must resolve (DNS A/AAAA) to this host.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
# E-mail for Let's Encrypt / ACME (where TLS-renewal notices go).
ACME_EMAIL=you@example.com

# Postgres — change the credentials for a real deployment.
POSTGRES_USER=organizer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=organizer

# Auth — REQUIRED in production. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URLs behind the proxy (https on the subdomains above).
BETTER_AUTH_URL=https://api.example.com
AUTH_TRUSTED_ORIGINS=https://app.example.com
MCP_PUBLIC_URL=https://mcp.example.com
# Parent domain so the session cookie is shared across the app./api. subdomains
# (cross-subdomain login). Unset locally, where web/API share a host.
AUTH_COOKIE_DOMAIN=example.com
# Lifetime in seconds of the OAuth tokens the MCP login issues (defaults 7 days
# and 30 days). Exposed to the internet, prefer shorter ones.
# MCP_ACCESS_TOKEN_TTL=604800
# MCP_REFRESH_TOKEN_TTL=2592000

# Baked into the SPA at BUILD time (ssr:false) — must be set before `up --build`.
NUXT_PUBLIC_API_URL=https://api.example.com

# GitHub OAuth (optional) — callback https://api.example.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
