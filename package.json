{
  "name": "claude-organizer",
  "version": "0.34.1",
  "private": true,
  "description": "Project management system for Claude Code: cards, sprints, roadmaps, docs - exposed via MCP",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @claude-organizer/db generate",
    "db:migrate": "pnpm --filter @claude-organizer/db migrate",
    "db:studio": "pnpm --filter @claude-organizer/db studio",
    "backfill:embeddings": "tsx packages/core/scripts/backfill-embeddings.ts",
    "dev:api": "pnpm --filter @claude-organizer/api dev",
    "dev:web": "pnpm --filter @claude-organizer/web dev",
    "dev:mcp": "pnpm --filter @claude-organizer/mcp dev",
    "dev:embedding": "pnpm --filter @claude-organizer/embedding-service dev",
    "dev": "pnpm db:up && pnpm -r --parallel --filter './packages/*' dev",
    "build": "pnpm -r build",
    "attach-commit": "node plugins/claude-organizer/skills/implement/scripts/attach-commit.mjs",
    "attach-image": "node plugins/claude-organizer/scripts/attach-image.mjs",
    "attach-worktree-diff": "node plugins/claude-organizer/skills/implement/scripts/attach-worktree-diff.mjs",
    "bump": "node scripts/bump-version.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @claude-organizer/core test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.4.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.6.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
