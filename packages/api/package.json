{
  "name": "@agents-board/api",
  "version": "0.37.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.mjs",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=../../.env dist/server.mjs",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@agents-board/auth": "workspace:*",
    "@agents-board/core": "workspace:*",
    "@agents-board/db": "workspace:*",
    "@agents-board/shared": "workspace:*",
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "10.0.0",
    "@fastify/websocket": "11.2.0",
    "better-auth": "1.6.14",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "postgres": "3.4.9",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
