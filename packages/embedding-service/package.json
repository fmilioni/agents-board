{
  "name": "@agents-board/embedding-service",
  "version": "0.37.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.mjs",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=../../.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@agents-board/core": "workspace:*",
    "@agents-board/db": "workspace:*",
    "@agents-board/shared": "workspace:*",
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
