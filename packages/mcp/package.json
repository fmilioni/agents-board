{
  "name": "@agents-board/mcp",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "bin": {
    "agents-board-mcp": "./dist/server.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "build": "tsup",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@agents-board/auth": "workspace:*",
    "@agents-board/core": "workspace:*",
    "@agents-board/db": "workspace:*",
    "@agents-board/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-auth": "1.6.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
